{
  "name": "grafana-mcp",
  "displayName": "Grafana (self-hosted)",
  "version": "0.3.0",
  "description": "For self-hosted Grafana, or any Grafana with a service-account token: dashboards, Prometheus, Loki, alerting, incidents, and OnCall via the Grafana MCP server, run locally in Docker.",
  "author": {
    "name": "Grafana Labs",
    "email": "grafana-assistant@grafana.com"
  },
  "homepage": "https://github.com/grafana/ai-marketplace/tree/main/plugins/grafana-mcp",
  "repository": "https://github.com/grafana/ai-marketplace",
  "license": "Apache-2.0",
  "keywords": [
    "grafana",
    "mcp",
    "observability",
    "dashboards",
    "prometheus",
    "loki"
  ],
  "logo": "assets/logo.svg",
  "mcpServers": {
    "grafana": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "-e",
        "GRAFANA_URL",
        "-e",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN",
        "grafana/mcp-grafana",
        "-t",
        "stdio"
      ],
      "env": {
        "GRAFANA_URL": "${GRAFANA_URL}",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${GRAFANA_SERVICE_ACCOUNT_TOKEN}"
      }
    }
  },
  "userConfig": {
    "grafana_url": {
      "env": "GRAFANA_URL",
      "type": "string",
      "title": "Grafana instance URL",
      "description": "Your Grafana instance URL. For Grafana Cloud: https://<stack>.grafana.net. For self-hosted: e.g. http://localhost:3000.",
      "required": true
    },
    "grafana_service_account_token": {
      "env": "GRAFANA_SERVICE_ACCOUNT_TOKEN",
      "type": "string",
      "title": "Grafana service account token",
      "description": "Create a service account token at <your-grafana-url>/org/serviceaccounts with at least Viewer role (Editor for write operations).",
      "required": true,
      "sensitive": true
    }
  },
  "platforms": {
    "claude": {},
    "cursor": {},
    "kiro": {
      "keywords": [
        "grafana",
        "mcp",
        "observability",
        "dashboards",
        "prometheus",
        "loki",
        "alerting",
        "incidents",
        "oncall",
        "monitoring"
      ]
    },
    "grok": {
      "marketplace": {
        "category": "monitoring",
        "homepage": "https://github.com/grafana/mcp-grafana",
        "keywords": [
          "grafana",
          "grafana mcp"
        ],
        "domains": [
          "grafana.com",
          "grafana.net"
        ]
      }
    }
  }
}
