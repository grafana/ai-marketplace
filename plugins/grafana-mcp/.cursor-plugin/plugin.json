{
  "name": "grafana-mcp",
  "displayName": "Grafana MCP",
  "version": "0.2.0",
  "description": "MCP server for AI-assisted Grafana dashboard, datasource, alerting, and incident management.",
  "author": {
    "name": "Grafana Labs",
    "email": "grafana-assistant@grafana.com"
  },
  "homepage": "https://github.com/grafana/ai-marketplace/tree/main/plugins/grafana-mcp",
  "repository": "https://github.com/grafana/ai-marketplace",
  "license": "Apache-2.0",
  "keywords": [
    "grafana",
    "mcp",
    "observability",
    "dashboards",
    "prometheus",
    "loki"
  ],
  "logo": "assets/logo.svg",
  "mcpServers": {
    "grafana": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "-e",
        "GRAFANA_URL",
        "-e",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN",
        "grafana/mcp-grafana",
        "-t",
        "stdio"
      ],
      "env": {
        "GRAFANA_URL": "${GRAFANA_URL}",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${GRAFANA_SERVICE_ACCOUNT_TOKEN}"
      }
    }
  }
}
