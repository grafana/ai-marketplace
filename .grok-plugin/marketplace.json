      "source": {
        "type": "local",
        "path": "./plugins/grafana-mcp"
      },
      "category": "monitoring",
      "homepage": "https://github.com/grafana/mcp-grafana",
      "keywords": [
        "grafana",
        "grafana mcp"
      ],
      "domains": [
        "grafana.com",
        "grafana.net"
      ]
    }
  ]
