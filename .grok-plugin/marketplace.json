        "type": "local",
        "path": "./plugins/grafana-cloud-mcp"
      },
      "category": "monitoring",
      "homepage": "https://grafana.com/products/cloud/",
      "keywords": [
        "grafana cloud",
        "grafana cloud mcp"
      ],
      "domains": [
        "grafana.com",
        "grafana.net"
      ]
    },
    {
      "name": "grafana-mcp",
